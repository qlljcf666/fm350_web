# FM350 NAT + 转发兜底规则
iptables -t nat -A POSTROUTING -o ppp0 -j MASQUERADE 2>/dev/null
iptables -t nat -A POSTROUTING -o usb1 -j MASQUERADE 2>/dev/null
iptables -t nat -A POSTROUTING -o wwan0 -j MASQUERADE 2>/dev/null
iptables -A INPUT -i usb0 -j ACCEPT
iptables -A INPUT -p tcp --dport 80 -j ACCEPT
iptables -A INPUT -p tcp --dport 443 -j ACCEPT
iptables -A INPUT -p tcp --dport 22 -j ACCEPT
iptables -A INPUT -p udp --dport 53 -j ACCEPT
iptables -A INPUT -p icmp --icmp-type echo-request -j ACCEPT
